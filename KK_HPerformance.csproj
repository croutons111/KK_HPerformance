<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>KK_HPerformance</AssemblyName>
    <RootNamespace>KK_HPerformance</RootNamespace>
    <Description>Reduce H scene freezes (loading caches) and frame cost (dynamic bones, metaball semen), with profilers</Description>
    <Version>0.9.0</Version>
    <TargetFramework>net35</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <OutputPath>bin\$(Configuration)\</OutputPath>
  </PropertyGroup>

  <Target Name="DeployToGame" AfterTargets="Build">
    <Copy SourceFiles="$(OutputPath)$(AssemblyName).dll"
          DestinationFolder="$(KKPath)\BepInEx\plugins"
          SkipUnchangedFiles="true" />
    <Message Text="Deployed: $(AssemblyName).dll → BepInEx/plugins/" Importance="high" />
  </Target>

</Project>
